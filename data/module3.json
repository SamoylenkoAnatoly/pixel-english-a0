            "lines": [
              {
                "en": "«Where is my key?» — says the ghost. They look under the table and under the bed.",
                "ru": "«Где мой ключ?» — говорит привидение. Они ищут под столом и под кроватью."
              },
              {
                "en": "There it is! On the floor! The ghost is happy!",
                "ru": "Вот же он! На полу! Привидение довольно!"
