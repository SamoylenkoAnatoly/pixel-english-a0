            "lines": [
              {
                "en": "Boo! It is a little ghost! «Don't run! I am friendly!»",
                "ru": "Бу! Это маленькое привидение! «Не убегай! я дружелюбное!»"
              },
              {
                "en": "There are no people in this house. The ghost is alone.",
                "ru": "В этом доме нет людей. Привидение одно."
